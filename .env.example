# Crypto Market Data Engineering System - Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# =============================================================================
# REQUIRED: Core Directory Configuration
# =============================================================================
ROOT_DIR=/path/to/project

# =============================================================================
# REQUIRED: Binance API Credentials
# =============================================================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For read-only access (market data):
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# For trading (if different from read-only):
# BINANCE_TRADING_API_KEY=your_trading_api_key
# BINANCE_TRADING_SECRET=your_trading_secret

# =============================================================================
# OPTIONAL: Tardis Market Data (for historical data)
# =============================================================================
# Get your API key from: https://tardis.dev/
TARDIS_API_KEY=your_tardis_api_key

# =============================================================================
# OPTIONAL: ClickHouse Database (for time-series storage)
# =============================================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# =============================================================================
# OPTIONAL: AWS Configuration (if using S3/Secrets Manager)
# =============================================================================
AWS_REGION=us-east-1
S3_BUCKET=your-data-bucket
# AWS credentials typically come from ~/.aws/credentials or IAM role

# =============================================================================
# OPTIONAL: Alerting Configuration
# =============================================================================
# Slack webhooks for job notifications
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_JOBS_WEBHOOK=
SLACK_PROD_JOBS_WEBHOOK=
SLACK_PNL_WEBHOOK=

# OpsGenie for incident management
OPSGENIE_API_KEY=
OPSGENIE_SCHEDULE_ID=
OPSGENIE_SCHEDULE_NAME=default_schedule

# =============================================================================
# OPTIONAL: OMS Configuration (for live trading)
# =============================================================================
OMS_IP=127.0.0.1
OMS_PORT=53118
CPP_OMS_IP=127.0.0.1
CPP_OMS_INGEST_PORT=5550
CPP_OMS_REPLY_PORT=5551
CPP_OMS_USER_DATA_PORT=5555

# =============================================================================
# OPTIONAL: Environment Mode
# =============================================================================
# Set to 'prod' for production mode, 'local' for development
STATARB_ENV=local
